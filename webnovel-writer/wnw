#!/bin/bash
# webnovel.py 包装器 —— 自动配置隔离 Python 与 PYTHONPATH
# 用法: wnw --project-root <书目录> <子命令> [参数]
set -uo pipefail

WNW_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 优先用带依赖的隔离环境：按平台探测（支持 WNW_PYTHON 覆盖），缺失时回退系统 python3
PY="${WNW_PYTHON:-}"
if [ -z "$PY" ]; then
  for candidate in \
    "$HOME/.workbuddy/binaries/python/envs/webnovel/bin/python" \
    "$HOME/.workbuddy/binaries/python/envs/webnovel/Scripts/python.exe" \
    "$HOME/.workbuddy/binaries/python/envs/default/bin/python" \
    "$HOME/.workbuddy/binaries/python/envs/default/Scripts/python.exe" ; do
    if [ -x "$candidate" ]; then PY="$candidate"; break; fi
  done
fi
if [ -z "$PY" ]; then
  PY="$(command -v python3 || command -v python)"
fi

PYTHONPATH="$WNW_ROOT/scripts" exec "$PY" -X utf8 "$WNW_ROOT/scripts/webnovel.py" "$@"
